{
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "startx": "yarn --cwd apps/frontend start",
    "nextx": "yarn --cwd apps/nextapp dev",
    "devx": "npm-run-all --parallel start next"
  },
  "devEngines": {
    "packageManager": {
      "name": "yarn",
      "version": "1.22.19"
    }
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "turbo": "^2.11.13"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
